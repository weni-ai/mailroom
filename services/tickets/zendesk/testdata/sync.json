    {
        "label": "compare open tickets without closing",
        "method": "POST",
        "path": "/mr/tickets/types/zendesk/sync/4ee6d4f3-f92b-439b-9718-8da90c05490b",
        "headers": {
            "Authorization": "Token sesame"
        },
        "body": {},
        "http_mocks": {
            "https://nyaruka.zendesk.com/api/v2/tickets/show_many.json?ids=101,102,103": [
                {
                    "status": 200,
                    "body": "{\"tickets\":[{\"id\":101,\"status\":\"open\"},{\"id\":102,\"status\":\"solved\"}]}"
                }
            ]
        },
        "status": 200,
        "response": {
            "ticketer": "4ee6d4f3-f92b-439b-9718-8da90c05490b",
            "sync": false,
            "counts": {
                "open_in_mailroom": 4,
                "in_sync": 1,
                "would_close": 1,
                "closed": 0,
                "missing_external_id": 1,
                "not_found": 1
            },
            "in_sync": [
                {
                    "uuid": "$open_uuid$",
                    "external_id": "101",
                    "zendesk_status": "open"
                }
            ],
            "would_close": [
                {
                    "uuid": "$solved_uuid$",
                    "external_id": "102",
                    "zendesk_status": "solved"
                }
            ],
            "closed": [],
            "missing_external_id": [
                {
                    "uuid": "$missing_uuid$"
                }
            ],
            "not_found": [
                {
                    "uuid": "$gone_uuid$",
                    "external_id": "103"
                }
            ]
        },
        "db_assertions": [
            {
                "query": "SELECT count(*) FROM tickets_ticket WHERE ticketer_id = 3 AND status = 'O'",
                "count": 4
            }
        ]
    },
    {
